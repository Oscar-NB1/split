# ---- database ----
# Neon or Supabase connection string (use the pooled URL)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- app ----
APP_URL=https://split.vercel.app
SESSION_SECRET=generate-with-openssl-rand-base64-32

# The household's timezone. Vercel runs Node with TZ=UTC, so without this the
# server thinks it is still yesterday between midnight and 02:00 local, and
# "this week" and "never write the past" both slip by a day. NEXT_PUBLIC_ on
# purpose: the browser and the server have to agree on what today is.
NEXT_PUBLIC_APP_TIMEZONE=Europe/Berlin

# Target race, counted down in the header. Optional; defaults to 2026-11-28.
NEXT_PUBLIC_RACE_DATE=2026-11-28

# Two people, two access codes. That is the whole auth system for now.
USER_A_EMAIL=you@example.com
USER_A_NAME=Oscar
USER_A_CODE=pick-something-long
USER_B_EMAIL=her@example.com
USER_B_NAME=Lea
USER_B_CODE=pick-something-else-long

# ---- strava ----
# strava.com/settings/api -> Authorization Callback Domain is your BARE domain:
# split.vercel.app     (no https://, no path)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=any-random-string

# ---- push notifications ----
# npx web-push generate-vapid-keys  -> paste both. The public one must be
# NEXT_PUBLIC_, because the browser needs it to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- cron ----
# any random string; Vercel sends it as a Bearer token to /api/cron
CRON_SECRET=

# ---- maps (optional) ----
# account.mapbox.com -> Tokens -> "Default public token" (starts pk.)
# Draws a real basemap under the GPS route. Without it the route still renders,
# as a plain outline. NOT prefixed NEXT_PUBLIC_ on purpose: the token stays on
# the server and the image is proxied through /api/activity/[id]/map, so it is
# never exposed to the browser.
# Free tier is 50,000 static images/month; this app makes about one per activity.
MAPBOX_TOKEN=
